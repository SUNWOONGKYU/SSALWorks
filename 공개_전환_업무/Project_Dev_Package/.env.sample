# SSAL Works Project Dev Package - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Supabase Configuration (Required for DB upload)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/{your-project}/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# Project Configuration
# ===========================================
# Unique identifier for your project (same as .ssal-project.json)
PROJECT_ID=your-project-id

# Owner email (for progress tracking)
OWNER_EMAIL=your-email@example.com

# ===========================================
# Optional Settings
# ===========================================
# Set to true to enable automatic progress upload on git commit
AUTO_UPLOAD_PROGRESS=true

# Set to true for verbose logging
DEBUG_MODE=false
